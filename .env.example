# Copy to .env and fill in. .env is gitignored; this template is committed.
#
# You do NOT need any of this to try the system. The `offline` provider runs the
# full pipeline deterministically with no network, no credentials, and no cost:
#     python coscientist.py "your goal" --provider offline
#
# For real model calls, pick a provider below. config.yaml ships
# `provider: claude-code`, which uses an installed and authenticated `claude` CLI
# and needs no token at all. Setting COSCIENTIST_PROVIDER here OVERRIDES that —
# comment the line out to keep the claude-code default.
#
# NOTE: do not put a trailing `# comment` on an uncommented assignment line.
# python-dotenv strips an inline comment only after a non-empty value, so on an
# empty key the comment text BECOMES the value — which looks set, defeats the
# missing-token check, and fails later as an unexplained 401.
# claude-code | anthropic | codex | openai-compatible | offline
COSCIENTIST_PROVIDER=claude-code

# ANTHROPIC_API_KEY=           # only for provider=anthropic (metered, pay-per-token)
# OPENAI_API_KEY=              # if required by the configured OpenAI-compatible endpoint
# TAVILY_API_KEY=              # optional web search; system runs without it

# CLI-backed providers use their own login state instead of a key in this file:
#   claude-code  -> `claude` must be installed and authenticated
#   codex        -> `codex` must be installed and authenticated
#
# For local/hosted OpenAI-compatible models, set base_url, model_fast, and
# model_strong under openai_compatible in config.yaml. Set api_key_env: null
# there when the local server does not require authentication.

# Modal — serverless GPU for the T2 fidelity tier (structure/affinity methods).
# Preferred setup is `modal token new` (writes ~/.modal.toml, outside the repo).
# These env vars are the non-interactive alternative. BILLED: enabling T2 methods
# (quarter --structure) spends real Modal credits.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=
